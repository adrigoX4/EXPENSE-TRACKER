# Copy to .env and adjust if needed. All settings are optional.

# SQLite by default. Use an absolute path or a path relative to the project root.
CARTFLOW_DATABASE_URL=sqlite:///./college_cart.db

# Used for daily grouping, cash sessions and report boundaries.
CARTFLOW_BUSINESS_TIMEZONE=Asia/Kolkata

# Set to true to allow browser requests from another local dev server origin.
CARTFLOW_DEV_CORS=false

# Public origin used for canonical URLs, sitemap.xml and social share images.
# Leave empty to derive it from each request. Use your HTTPS domain in production.
CARTFLOW_PUBLIC_BASE_URL=

# This app holds private financial records. Keep indexing disabled unless the
# site is protected by authentication and you intend it to be publicly listed.
CARTFLOW_ALLOW_INDEXING=false

# --- Accounts and sign-in ---

# Account store: emails and password hashes only, never business records.
CARTFLOW_ACCOUNTS_DB_PATH=accounts.db

# Every account after the first gets its own database in this folder.
CARTFLOW_USERS_DATA_DIR=user_data

# Signing secret for session cookies. Leave empty to generate and store one
# automatically in accounts.db. Set a long random value in production.
CARTFLOW_SECRET_KEY=

# How long a sign-in cookie remains valid.
CARTFLOW_SESSION_DAYS=30

# Set to false after creating your accounts to close public registration.
CARTFLOW_ALLOW_SIGNUP=true

# Password hashing work factor (PBKDF2-HMAC-SHA256).
CARTFLOW_PASSWORD_ITERATIONS=600000

# Force Secure cookies when HTTPS is terminated by a reverse proxy.
CARTFLOW_COOKIE_SECURE=false
